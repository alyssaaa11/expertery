;; Keel v2 sandbox for model answers (PLAN.md 4c; tested profile committed as
;; `sandbox.reference.sb`). `(allow default)`, no network, reads under
;; /Users/alyssa denied except the venv, the uv Python install, `company/`,
;; the answer's own scratch dir and this lineage's `run_one.py` (passed with
;; -D and `(param ...)`), writes only to the scratch dir and /dev/null.
;; NOTE vs the reference: one extra read allow for `run_one.py` itself.
;; Without it the PLAN 4c command cannot run at all: the child is denied
;; reading run_one.py from the repo (verified: Errno 1 on open). The scratch
;; path passed with -D SCRATCH must be fully resolved (no symlinks such as
;; /tmp -> /private/tmp); the runner realpaths it before launching.
(version 1)
(allow default)
(deny network*)
(deny file-read* (subpath "/Users/alyssa"))
(allow file-read* (subpath (param "VENV")) (subpath (param "PYHOME")) (subpath (param "COMPANY")) (subpath (param "SCRATCH")))
(allow file-read* (literal (param "RUNONE")))
(allow file-read-metadata)
(deny file-write*)
(allow file-write* (subpath (param "SCRATCH")) (literal "/dev/null"))
